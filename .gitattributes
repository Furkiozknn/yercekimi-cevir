# Metin dosyalari her yerde LF kalsin (Godot LF yazar, CRLF donusumu gereksiz fark uretir).
* text=auto eol=lf

# Ikili varliklar LFS'te tutulur.
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text

# Yardimci betikler dil istatistiginden cikarilir: bu bir Godot oyunu, "Python" degil.
arac/** linguist-detectable=false
docs/** linguist-documentation
