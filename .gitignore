# Godot 4+ ozel
.godot/
/android/

# Disari aktarilan yapilar
# NOT: "build/" degil "build/*". Git yok saydigi DIZINE hic inmiyor,
# o yuzden dizinin kendisi yok sayilirken alttaki istisna calismaz.
build/*
# Godot'nun disari aktarma ciktisini yeniden ICE AKTARMASINI engelleyen
# isaret dosyasi depoda kalmali. Olmazsa .godot/ sisiyor ve gecmiste pck
# de sismisti; taze klonda kimse elle olusturmayi hatirlamaz.
!build/.gdignore
builds/
*.exe
*.pck
*.zip
*.apk
*.aab

# Isletim sistemi
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
*.tmp

# rFXGen ham ciktilari (tools/uret_ses.py yeniden uretir)
assets/audio/ham/

# Tanitim GIF ara dosyasi (5 MB ham RGB; tools/gif_yap.py girdisi)
yayin/tanitim/kareler.raw

# Python onbellegi (tools/uret_sprite.py ice aktarilinca olusuyor)
__pycache__/
